{
  "name": "remons-markdown-plugins",
  "version": "2.0.0-beta.0",
  "description": "Markdown-it container plugins with React components",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/liRemons/markdown-plugins"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "postbuild": "node scripts/verify-exports.mjs",
    "dev": "vite",
    "dev:build": "vite build",
    "dev:preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx src scripts demo",
    "lint:fix": "eslint --ext .ts,.tsx src scripts demo --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,less}\" \"demo/**/*.{ts,tsx,less}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,less}\" \"demo/**/*.{ts,tsx,less}\" \"scripts/**/*.mjs\"",
    "prepublishOnly": "npm run typecheck && npm run build",
    "link:rm": "npm link ../render-markdown",
    "unlink:rm": "npm unlink remons-render-markdown && npm install --no-save",
    "link:rm:build": "npm --prefix ../render-markdown run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "markdown-it-container": "^4.0.0",
    "remons-calendar": "^1.0.0-beta.9",
    "remons-render-markdown": "^2.0.1-beta.4"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5.0.0",
    "antd": ">=5.21.6",
    "dayjs": ">=1.11.13",
    "markdown-it": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "markdown-it": {
      "comments": "markdown-it 只在渲染阶段使用,部分 SSR 场景可以先不安装"
    },
    "antd": {
      "optional": true,
      "comments": "仅在使用 render-calendar 插件时需要(remons-calendar 内部依赖 antd Badge/Tag); 其他插件无 antd 依赖"
    },
    "dayjs": {
      "optional": true,
      "comments": "仅在使用 render-calendar 插件时需要(remons-calendar 内部依赖 dayjs)"
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^5.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "antd": "^5.21.6",
    "dayjs": "^1.11.13",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "highlight.js": "^11.12.0",
    "less": "^4.2.0",
    "markdown-it": "^13.0.2",
    "prettier": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/index.css",
    "./plugins/render-amap": {
      "import": {
        "types": "./dist/plugins/render-amap.d.ts",
        "default": "./dist/plugins/render-amap.js"
      },
      "require": {
        "types": "./dist/plugins/render-amap.d.cts",
        "default": "./dist/plugins/render-amap.cjs"
      }
    },
    "./plugins/render-amap/style.css": "./dist/plugins/render-amap.css",
    "./plugins/render-badge": {
      "import": {
        "types": "./dist/plugins/render-badge.d.ts",
        "default": "./dist/plugins/render-badge.js"
      },
      "require": {
        "types": "./dist/plugins/render-badge.d.cts",
        "default": "./dist/plugins/render-badge.cjs"
      }
    },
    "./plugins/render-badge/style.css": "./dist/plugins/render-badge.css",
    "./plugins/render-calendar": {
      "import": {
        "types": "./dist/plugins/render-calendar.d.ts",
        "default": "./dist/plugins/render-calendar.js"
      },
      "require": {
        "types": "./dist/plugins/render-calendar.d.cts",
        "default": "./dist/plugins/render-calendar.cjs"
      }
    },
    "./plugins/render-calendar/style.css": "./dist/plugins/render-calendar.css",
    "./plugins/render-link-preview-card": {
      "import": {
        "types": "./dist/plugins/render-link-preview-card.d.ts",
        "default": "./dist/plugins/render-link-preview-card.js"
      },
      "require": {
        "types": "./dist/plugins/render-link-preview-card.d.cts",
        "default": "./dist/plugins/render-link-preview-card.cjs"
      }
    },
    "./plugins/render-link-preview-card/style.css": "./dist/plugins/render-link-preview-card.css",
    "./plugins/render-share-code": {
      "import": {
        "types": "./dist/plugins/render-share-code.d.ts",
        "default": "./dist/plugins/render-share-code.js"
      },
      "require": {
        "types": "./dist/plugins/render-share-code.d.cts",
        "default": "./dist/plugins/render-share-code.cjs"
      }
    },
    "./plugins/render-share-code/style.css": "./dist/plugins/render-share-code.css"
  }
}
