{
  "name": "remons-markdown-plugins",
  "version": "1.0.0-beta.6",
  "description": "Markdown-it container plugins with React components",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/liRemons/markdown-plugins"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "postbuild": "node scripts/generate-exports.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "methods-r": "^1.0.0",
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "antd": ">=5.0.0",
    "@ant-design/icons": ">=5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "rollup": "^4.9.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "tsup": "^8.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-dts": "^6.1.0",
    "less": "^4.2.0",
    "@ant-design/icons": "^5.3.0",
    "antd": "^5.12.0",
    "markdown-it-container": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/index.css",
    "./plugins/render-amap": {
      "import": {
        "types": "./dist/plugins/render-amap.d.ts",
        "default": "./dist/plugins/render-amap.js"
      },
      "require": {
        "types": "./dist/plugins/render-amap.d.cts",
        "default": "./dist/plugins/render-amap.cjs"
      }
    },
    "./plugins/render-amap/style.css": "./dist/plugins/render-amap.css",
    "./plugins/render-badge": {
      "import": {
        "types": "./dist/plugins/render-badge.d.ts",
        "default": "./dist/plugins/render-badge.js"
      },
      "require": {
        "types": "./dist/plugins/render-badge.d.cts",
        "default": "./dist/plugins/render-badge.cjs"
      }
    },
    "./plugins/render-badge/style.css": "./dist/plugins/render-badge.css",
    "./plugins/render-link-preview-card": {
      "import": {
        "types": "./dist/plugins/render-link-preview-card.d.ts",
        "default": "./dist/plugins/render-link-preview-card.js"
      },
      "require": {
        "types": "./dist/plugins/render-link-preview-card.d.cts",
        "default": "./dist/plugins/render-link-preview-card.cjs"
      }
    },
    "./plugins/render-link-preview-card/style.css": "./dist/plugins/render-link-preview-card.css",
    "./plugins/render-share-code": {
      "import": {
        "types": "./dist/plugins/render-share-code.d.ts",
        "default": "./dist/plugins/render-share-code.js"
      },
      "require": {
        "types": "./dist/plugins/render-share-code.d.cts",
        "default": "./dist/plugins/render-share-code.cjs"
      }
    },
    "./plugins/render-share-code/style.css": "./dist/plugins/render-share-code.css"
  }
}
